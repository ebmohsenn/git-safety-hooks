#!/usr/bin/env bash
# git-safety-hooks — pre-commit
#
# Fast guards (well under a second on a normal commit), in this order:
#   fix-perms       OPT-IN   make staged files world-readable (shared machines)
#   secret-scan     ON       staged additions carrying a secret (needs node)
#   ratchet         CONFIG   listed files may only shrink
#   stale-revert    ON       the commit silently undoes a recent commit (needs node)
#   migrations      CONFIG   duplicate migration numbers
#   typecheck       OPT-IN   staged-only TypeScript check with a coverage guard (slow)
#
# Settings: .git-safety.conf (git-config syntax) or `git config safety.<key>`; see README.
# Skip one run of a check: SAFETY_SKIP="secret-scan,stale-revert" git commit …   (said when used)
set -euo pipefail

HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
LIB="$HOOK_DIR/lib"
# shellcheck source=lib/config.sh
. "$LIB/config.sh"
cd "$SAFETY_ROOT"

# core.quotePath=off: otherwise git prints a non-ASCII path as "caf\303\251.ts" and the checks below
# (which match on the name) silently pass over it. T = type changes (a symlink replaced by a file).
STAGED="$(git -c core.quotePath=off diff --cached --name-only --diff-filter=ACMRT || true)"
if [ -z "$STAGED" ] && [ -z "$(git diff --cached --name-only --diff-filter=D || true)" ]; then
  chain_local_hook pre-commit "$@"
  exit 0
fi


# ── fix-perms (opt-in) ─────────────────────────────────────────────────────────────────────
if [ "$(cfg_bool fixPerms.enabled false)" = "true" ] && ! skipped fix-perms && [ -n "$STAGED" ]; then
  # shellcheck source=lib/fix-perms.sh
  . "$LIB/fix-perms.sh"
  _files=(); IFS=$'\n' read -r -d '' -a _files <<< "$STAGED" || true   # lines → array (bash 3.2: no mapfile)
  run_fix_perms ${_files[@]+"${_files[@]}"}
fi

# ── secret scan ────────────────────────────────────────────────────────────────────────────
if [ "$(cfg_bool secretScan.enabled true)" != "true" ]; then
  # Off on this machine (git config) is the user's own choice. Off because the COMMITTED file says
  # so is worth a line every time: whoever last edited that file made the choice for everyone.
  if ! git config --get safety.secretScan.enabled >/dev/null 2>&1; then
    echo "⚠️  git-safety-hooks: the secret scan is switched OFF by $(_safety_conf_file) (secretScan.enabled)." >&2
  fi
elif ! skipped secret-scan && need_node secret-scan; then
  _env_files="$(cfg_all secretScan.envFile)"
  [ -n "$_env_files" ] || _env_files=".env"
  SECRET_SCAN_ENV_FILES="${SECRET_SCAN_ENV_FILES-$_env_files}" \
  SECRET_SCAN_EXTRA_PATTERNS="${SECRET_SCAN_EXTRA_PATTERNS-$(cfg_all secretScan.pattern)}" \
  SECRET_SCAN_IGNORE_PATHS="${SECRET_SCAN_IGNORE_PATHS-$(cfg_all secretScan.ignorePath)}" \
  SECRET_SCAN_ALLOW_NAMES="${SECRET_SCAN_ALLOW_NAMES-$(cfg_all secretScan.allowName)}" \
    node "$LIB/secret-scan.mjs" || exit 1
fi

# ── shrink-only ratchet ────────────────────────────────────────────────────────────────────
_ratchet_files="$(cfg_all ratchet.file)"
if [ -n "$_ratchet_files" ] && ! skipped ratchet; then
  # shellcheck source=lib/ratchet.sh
  . "$LIB/ratchet.sh"
  _rfiles=(); IFS=$'\n' read -r -d '' -a _rfiles <<< "$_ratchet_files" || true   # lines → array (bash 3.2: no mapfile)
  run_ratchet "$(cfg_get ratchet.hint "")" ${_rfiles[@]+"${_rfiles[@]}"} || exit 1
fi

# ── stale-copy revert guard ────────────────────────────────────────────────────────────────
if [ "$(cfg_bool staleRevert.enabled true)" = "true" ] && ! skipped stale-revert && need_node stale-revert; then
  STALE_GUARD_WINDOW_HOURS="${STALE_GUARD_WINDOW_HOURS-$(cfg_get staleRevert.windowHours "")}" \
  STALE_GUARD_RATIO="${STALE_GUARD_RATIO-$(cfg_get staleRevert.ratio "")}" \
  STALE_GUARD_MIN_LINES="${STALE_GUARD_MIN_LINES-$(cfg_get staleRevert.minLines "")}" \
  STALE_GUARD_SMALL_WINDOW_MIN="${STALE_GUARD_SMALL_WINDOW_MIN-$(cfg_get staleRevert.smallWindowMinutes "")}" \
  STALE_GUARD_SKIP_PATHS="${STALE_GUARD_SKIP_PATHS-$(cfg_all staleRevert.skipPath)}" \
    node "$LIB/stale-revert-guard.mjs" || exit 1
fi

# ── migration-number collisions ────────────────────────────────────────────────────────────
_mig_dirs="$(cfg_all migrations.dir)"
if [ -n "$_mig_dirs" ] && ! skipped migrations; then
  # shellcheck source=lib/migration-numbers.sh
  . "$LIB/migration-numbers.sh"
  _mdirs=(); IFS=$'\n' read -r -d '' -a _mdirs <<< "$_mig_dirs" || true   # lines → array (bash 3.2: no mapfile)
  _touched=0
  for _d in ${_mdirs[@]+"${_mdirs[@]}"}; do
    if staged_under "$_d"; then _touched=1; fi
  done
  if [ "$_touched" = 1 ]; then run_migration_numbers ${_mdirs[@]+"${_mdirs[@]}"} || exit 1; fi
fi

# ── staged-only typecheck (opt-in, slow) ───────────────────────────────────────────────────
_tc_projects="$(cfg_all typecheck.project)"
if [ -n "$_tc_projects" ] && [ -n "$STAGED" ] && [ "$(cfg_bool typecheck.enabled true)" = "true" ]; then
  if [ -n "${SKIP_TYPECHECK:-}" ]; then
    echo "⚠️  git-safety-hooks: typecheck skipped — SKIP_TYPECHECK=$SKIP_TYPECHECK" >&2
  elif ! skipped typecheck; then
    # shellcheck source=lib/typecheck-staged.sh
    . "$LIB/typecheck-staged.sh"
    # The compiler command is RUN, so it comes from this machine only (the environment or
    # `git config safety.typecheck.command`), never from the committed .git-safety.conf: a file
    # that arrives with a clone, a pull or a branch switch must not be able to name a program.
    TC_CMD="${TYPECHECK_CMD:-$(cfg_local typecheck.command "npx --no-install tsc")}"
    if cfg_in_repo_file typecheck.command && [ -z "${TYPECHECK_CMD:-}" ] && ! git config --get safety.typecheck.command >/dev/null 2>&1; then
      echo "⚠️  git-safety-hooks: typecheck.command in $(_safety_conf_file) is ignored (a committed file may not name a" >&2
      echo "   command to run). To use it on this machine: git config safety.typecheck.command '<command>'" >&2
    fi
    TC_EXCLUDES="$(cfg_all typecheck.exclude)"
    _failed=0
    _tprojects=(); IFS=$'\n' read -r -d '' -a _tprojects <<< "$_tc_projects" || true   # lines → array (bash 3.2: no mapfile)
    for _p in ${_tprojects[@]+"${_tprojects[@]}"}; do
      _pdir="$(dirname "$_p")"
      if [ "$_pdir" = "." ] || staged_under "$_pdir"; then
        tc_check_project "$_p" || _failed=1
      fi
    done
    if [ "$_failed" -ne 0 ]; then
      echo ""
      echo "Fix the errors above, or SKIP_TYPECHECK=1 git commit … if you are deliberately landing"
      echo "work-in-progress (the fast guards still run)."
      exit 1
    fi
  fi
fi

chain_local_hook pre-commit "$@"
