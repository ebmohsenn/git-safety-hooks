#!/usr/bin/env bash
# git-safety-hooks — pre-push
#
# OPT-IN push guard: only refs you list may be pushed, and remote refs may not be deleted.
# Useful for trunk-based repos ("only main and tags go to origin") and for agents that keep local
# scratch branches that must never reach the remote.
#
#   [pushGuard]
#       allow = refs/heads/main        # shell glob patterns, matched against the REMOTE ref
#       allow = refs/tags/*
#       remote = origin                # optional: only guard these remotes (default: all)
#       allowDeletes = false           # default false: refuse deleting a remote ref
#
# With no `pushGuard.allow` configured the guard is off.
# Override once (deliberate, rare): PUSH_GUARD_OVERRIDE=1 git push …
set -u

HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
LIB="$HOOK_DIR/lib"
# shellcheck source=lib/config.sh
. "$LIB/config.sh"

REMOTE_NAME="${1:-${PRE_COMMIT_REMOTE_NAME:-}}"
INPUT="$(cat)"
# Under the pre-commit framework there is no stdin; it describes the push in env vars instead.
if [ -z "$INPUT" ] && [ -n "${PRE_COMMIT_REMOTE_BRANCH:-}" ]; then
  INPUT="${PRE_COMMIT_LOCAL_BRANCH:-HEAD} ${PRE_COMMIT_TO_REF:-HEAD} $PRE_COMMIT_REMOTE_BRANCH ${PRE_COMMIT_FROM_REF:-}"
fi

guard() {
  [ "${PUSH_GUARD_OVERRIDE:-}" = "1" ] && return 0
  skipped push-guard && return 0
  local allow remotes r ok
  allow="$(cfg_all pushGuard.allow)"
  [ -n "$allow" ] || return 0
  remotes="$(cfg_all pushGuard.remote)"
  if [ -n "$remotes" ]; then
    ok=0
    while IFS= read -r r; do [ "$r" = "$REMOTE_NAME" ] && ok=1; done <<EOF
$remotes
EOF
    [ "$ok" = 1 ] || return 0
  fi
  local allow_deletes bad=0 local_ref local_sha remote_ref pat matched
  allow_deletes="$(cfg_bool pushGuard.allowDeletes false)"
  while read -r local_ref local_sha remote_ref _; do
    [ -z "${remote_ref:-}" ] && continue
    # a deletion has an all-zero local sha (40 or 64 zeros, SHA-1 or SHA-256 repos)
    case "$local_sha" in *[!0]*) ;; *)
      if [ "$allow_deletes" != "true" ]; then
        echo "✖ pre-push: refusing to DELETE remote ref $remote_ref (PUSH_GUARD_OVERRIDE=1 to override)." >&2
        bad=1
      fi
      continue ;;
    esac
    matched=0
    while IFS= read -r pat; do
      [ -z "$pat" ] && continue
      # shellcheck disable=SC2254  # glob match intended
      case "$remote_ref" in $pat) matched=1; break ;; esac
    done <<EOF
$allow
EOF
    if [ "$matched" = 0 ]; then
      echo "✖ pre-push: refusing to push $local_ref -> $remote_ref (not in pushGuard.allow)." >&2
      echo "  Allowed: $(printf '%s' "$allow" | tr '\n' ' ')" >&2
      bad=1
    fi
  done <<EOF
$INPUT
EOF
  return $bad
}

guard || exit 1
printf '%s\n' "$INPUT" | chain_local_hook pre-push "$@"
